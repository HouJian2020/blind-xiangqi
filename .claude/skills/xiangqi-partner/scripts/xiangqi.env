# 盲棋对弈配置文件
# Shell 和 Python 共用此配置

# Python 解释器路径 (conda auto-dev 环境)
# Linux/Mac: ~/miniconda3/envs/auto-dev/bin/python
# Windows: %USERPROFILE%\miniconda3\envs\auto-dev\python.exe
PYTHON_INTERPRETER=~/miniconda3/envs/auto-dev/bin/python

# 对局存储目录
GAME_STORAGE_DIR=~/.blind-xiangqi/games

# 图片输出目录
IMAGE_OUTPUT_DIR=~/.blind-xiangqi/images

# 默认执方 (red/black)
DEFAULT_PLAYER_COLOR=red

# 默认难度等级 (1-10)
DEFAULT_LEVEL=3